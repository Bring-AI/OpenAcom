<ScrollViewer Grid.Row="1" x:Name="WatchPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="720" HorizontalAlignment="Left"><Border Background="#1D2530" CornerRadius="12" Padding="22" Margin="0,0,0,20"><StackPanel><TextBlock Text="让收件箱保持在线" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="持续监听本机 inbox 的新未读消息。最小化窗口后仍会继续，退出应用时停止。监听只负责提醒，不会自动重试或标记已读。" TextWrapping="Wrap" Foreground="#9BAABF" LineHeight="23" Margin="0,12,0,0"/></StackPanel></Border><TextBlock Text="收件地址（* 表示所有地址）"/><TextBox x:Name="WatchReceiver" Text="desktop:operator" Margin="0,8,0,16"/><TextBlock Text="检查间隔（秒，1–60）"/><TextBox x:Name="WatchInterval" Text="2" Margin="0,8,0,16"/><CheckBox x:Name="WatchExisting" Content="启动时也提示现有未读消息" Foreground="#ADB9CC" Margin="0,0,0,12"/><CheckBox x:Name="WatchNotify" Content="显示托盘通知" IsChecked="True" Foreground="#ADB9CC" Margin="0,0,0,12"/><StackPanel Orientation="Horizontal" Margin="0,12,0,20"><Button x:Name="WatchStart" Content="开始监听" Background="#A99ADD" Foreground="#191523" Margin="0,0,12,0"/><Button x:Name="WatchStop" Content="停止监听" Margin="0,0,12,0"/><Button x:Name="WatchOpen" Content="查看新消息"/></StackPanel><Border Background="#1B202B" CornerRadius="10" Padding="20"><StackPanel><TextBlock x:Name="WatchState" Text="○  尚未开启" FontSize="17" Foreground="#A2AFBF"/><TextBlock x:Name="WatchCount" Text="已提示 0 条新消息" Foreground="#90BDAF" Margin="0,12,0,0"/><TextBlock x:Name="WatchLast" Text="" TextWrapping="Wrap" Foreground="#94A1B6" Margin="0,12,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
<ScrollViewer Grid.Row="1" x:Name="ControlsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><WrapPanel x:Name="ControlTabs" Margin="0,0,0,20"/><Border Background="#1A1F29" CornerRadius="12" Padding="24"><StackPanel x:Name="ControlForm"/></Border><TextBox x:Name="ControlOutput" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0" Visibility="Collapsed"/></StackPanel></ScrollViewer><ScrollViewer Grid.Row="1" x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="610" HorizontalAlignment="Left"><Border Background="#1C212A" CornerRadius="10" Padding="24"><StackPanel><TextBlock Text="本机优先，远端可选" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="本机消息直接使用 OpenAcom SDK。连接远端 Hub 后，也能向其节点发送消息。可选择使用 Windows 加密保存连接凭据。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="24"/></StackPanel></Border><TextBlock Text="Hub 地址（可通过 SSH 转发到本机）" Margin="0,26,0,9"/><TextBox x:Name="HubUrl" Text="http://127.0.0.1:9330"/><TextBlock Text="访问令牌" Margin="0,20,0,9"/><PasswordBox x:Name="HubToken"/><StackPanel Orientation="Horizontal" Margin="0,22,0,25"><Button x:Name="ConnectButton" Content="连接 Hub" Background="#AF9FF5" Foreground="#1D1732" Margin="0,0,12,0"/><Button x:Name="LocalButton" Content="使用本机"/></StackPanel><CheckBox x:Name="RememberConnection" Content="在这台电脑记住连接（Windows 加密保存令牌）" Foreground="#ADB7C8" Margin="0,0,0,12"/><Button x:Name="SaveConnectionButton" Content="保存连接设置" HorizontalAlignment="Left" Margin="0,0,0,24"/><TextBlock Text="运行环境" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="RuntimeInfo" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="23"/></StackPanel></ScrollViewer>
<Border Grid.Row="2" Margin="0,18,0,0" Padding="12,10" Background="#1A1F27" CornerRadius="6"><TextBlock x:Name="StatusText" Text="准备就绪 · 本机工作台" Foreground="#9CA5B7" TextWrapping="Wrap" FontSize="11"/></Border>
</Grid>
<Border x:Name="ComposeOverlay" Grid.ColumnSpan="2" Background="#B0000000" Visibility="Collapsed"><Border Width="520" Background="#1C2029" CornerRadius="14" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center" MaxHeight="760"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Grid><TextBlock Text="发送新消息" FontSize="23" FontWeight="SemiBold"/><Button x:Name="CloseCompose" Content="✕" HorizontalAlignment="Right" Background="Transparent" Padding="9,4"/></Grid><TextBlock Text="先保存到 inbox，再尝试所选路线。" Foreground="{StaticResource Muted}" Margin="0,10,0,22"/><TextBlock Text="收件地址" Margin="0,0,0,8"/><ComboBox x:Name="RecipientPicker" Height="32" Margin="0,0,0,8" DisplayMemberPath="Title"/><TextBox x:Name="Recipient" ToolTip="例如 zcode:session-id 或 node:machine/target"/><TextBlock Text="投递路线" Margin="0,18,0,8"/><ComboBox x:Name="RouteBox" Height="35" SelectedIndex="0"><ComboBoxItem Content="自动选择 · zcode 默认桌面 CDP" Tag="auto"/><ComboBoxItem Content="桌面 CDP · 不回退其他路线" Tag="desktopcdp"/><ComboBoxItem Content="会话适配器" Tag="session"/><ComboBoxItem Content="桌面兼容投递（可用 UIA）" Tag="desktop"/><ComboBoxItem Content="远端 Relay" Tag="relay"/><ComboBoxItem Content="仅保存到 inbox" Tag="mailbox"/></ComboBox><Expander x:Name="AdvancedSend" Header="投递参数" Foreground="#ADB7C8" Margin="0,12,0,0"><StackPanel><TextBlock Text="发送方" Margin="0,8,0,5"/><TextBox x:Name="SenderBox" Text="desktop:operator"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="超时（毫秒）" Margin="0,0,0,5"/><TextBox x:Name="TimeoutBox" Text="60000"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="CDP 端口" Margin="0,0,0,5"/><TextBox x:Name="CdpPortBox" Text="9222"/></StackPanel></Grid><TextBlock Text="CDP 页面 ID（可留空）" Margin="0,8,0,5"/><TextBox x:Name="CdpTargetBox"/><ComboBox x:Name="ModeBox" SelectedIndex="0" Height="32" Margin="0,8,0,8"><ComboBoxItem Tag="" Content="远端模式：使用目标默认值"/><ComboBoxItem Tag="draft" Content="远端模式：只填入草稿"/><ComboBoxItem Tag="submit" Content="远端模式：提交"/></ComboBox><CheckBox x:Name="WaitBox" Content="等待会话回复（会话路线）" Foreground="#ADB7C8"/><CheckBox x:Name="NoSignatureBox" Content="不添加发送方签名" Foreground="#ADB7C8" Margin="0,7,0,0"/></StackPanel></Expander><TextBlock Text="消息内容" Margin="0,18,0,8"/><TextBox x:Name="MessageText" Height="152" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><CheckBox x:Name="ConsentBox" Foreground="#B7BFCE" Content="允许本次消息在桌面中提交（按 Enter）" Margin="0,17,0,19"/><CheckBox x:Name="RetryVerified" Content="我已核实上次未送达，确认再投递一次" Foreground="#D9B481" Visibility="Collapsed" Margin="0,0,0,12"/><TextBlock x:Name="SendStatus" Foreground="#D9B481" TextWrapping="Wrap" Margin="0,0,0,12"/><Button x:Name="CheckCdpTargetButton" Content="检查目标会话（不发送）" Margin="0,0,0,10"/><Button x:Name="FixCdpButton" Content="检查 / 启用 ZCode CDP" Visibility="Collapsed" Margin="0,0,0,12"/><Button x:Name="SendButton" Content="发送消息  ↗" Background="#AF9FF5" Foreground="#1D1732" FontWeight="SemiBold"/></StackPanel></ScrollViewer></Border></Border>
