{
  "name": "openacom",
  "version": "0.16.4",
  "description": "One MCP/CLI command managing agent sessions across desktops and CLIs on different local/remote machines",
  "license": "MIT",
  "bin": {
    "openacom": "bin/openacom.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bring-AI/OpenAcom.git"
  },
  "keywords": [
    "claude-code",
    "codex",
    "zcode",
    "agent",
    "cli",
    "sessions",
    "relay"
  ],
  "private": false,
  "scripts": {
    "update": "git pull && npm install -g .",
    "test": "node --test"
  },
  "dependencies": {},
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./embedded": {
      "types": "./lib/comms.d.ts",
      "default": "./lib/comms.js"
    },
    "./routing": {
      "types": "./lib/routing.d.ts",
      "default": "./lib/routing.js"
    }
  },
  "files": [
    "bin/",
    "lib/",
    "docs/",
    "README.md",
    "banner.png",
    "tools/",
    "desktop/"
  ]
}
